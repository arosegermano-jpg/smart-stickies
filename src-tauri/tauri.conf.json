{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SmartStickies",
  "version": "0.1.0",
  "identifier": "com.smartstickies.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
  {
    "title": "SmartStickies",
    "width": 800,
    "height": 600,
    "titleBarStyle": "Transparent",
    "hiddenTitle": true,
    "decorations": true,
    "backgroundColor": "#ffffff",
    "theme": "Light"
  }
]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
